            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman Test Book\",\n  \"author\": \"Test Author\",\n  \"isbn\": \"{{isbn}}\",\n  \"totalCopies\": 2,\n  \"genreId\": 1,\n  \"publishedYear\": 2020\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Generates a random valid ISBN and saves the new book's id to {{bookId}}."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('isbn', '978' + Math.floor(1000000000 + Math.random() * 9000000000));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
